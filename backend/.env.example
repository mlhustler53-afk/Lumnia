# Port for the backend server (default: 3001)
PORT=3001

# Frontend URL for CORS + browser redirect (Render: use your Vercel URL only)
FRONTEND_URL=https://lumnia-a2vb.vercel.app
# Local dev: set FRONTEND_URL=http://localhost:5173 in a local .env file (not on Render)

# Optional: full path to yt-dlp if it is not on PATH
# YTDLP_PATH=C:\path\to\yt-dlp.exe

# ── YouTube Cookie Authentication ──────────────────────────────────────────────
# Fixes "Sign in to confirm you're not a bot" on Render / cloud deployments.
# The app checks these locations in order:
#   1. Render Secret File: /opt/render/project/src/youtube-cookies.txt
#   2. CWD file:           <process.cwd()>/cookies.txt
#   3. YTDLP_COOKIES env:  explicit path to a Netscape cookies.txt
#   4. YTDLP_COOKIES_BASE64: base64-encoded cookies string → decoded at startup
#
# Export from browser while logged into YouTube:
#   https://github.com/yt-dlp/yt-dlp/wiki/Extractors#exporting-youtube-cookies

# YTDLP_COOKIES=/path/to/cookies.txt
# YTDLP_COOKIES_BASE64=<base64-encoded cookies.txt content>

# Optional: User-Agent string that EXACTLY matches the browser your cookies
# were exported from. Required for cookie auth to work reliably.
# YT_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 ...

# Optional: Piped API origin only (no /streams path) — used when yt-dlp is blocked on Render
# PIPED_API_URL=https://pipedapi.kavin.rocks

# Optional: Cobalt API URL for audio extraction fallback
# COBALT_API_URL=https://cobalt-api.kwiatekmiki.com
