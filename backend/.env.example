# Port for the backend server (default: 3001)
PORT=3001

# Frontend URL(s) for CORS — comma-separated for multiple deploys
FRONTEND_URL=http://localhost:5173,https://lumnia-a2vb.vercel.app

# Optional: full path to yt-dlp if it is not on PATH
# YTDLP_PATH=C:\path\to\yt-dlp.exe

# Optional: Netscape-format cookies.txt for YouTube (fixes "Sign in to confirm you're not a bot" on Render)
# Export from browser while logged into YouTube — see https://github.com/yt-dlp/yt-dlp/wiki/Extractors#exporting-youtube-cookies
# YTDLP_COOKIES=/path/to/cookies.txt

# Optional: Piped API instance used when yt-dlp is blocked (default: pipedapi.adminforge.de)
# PIPED_API_URL=https://pipedapi.adminforge.de
